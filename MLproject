name: mibici-equipo36

python_env: python_env.yaml

entry_points:
  ingest:
    parameters:
      start_date: {type: str, default: "2025-10"}
      end_date: {type: str, default: "2026-09"}
    command: >
      python -m mibici.dataset
      --start-date {start_date}
      --end-date {end_date}

  train:
    parameters:
      question: {type: str, default: "p1"}
      model: {type: str, default: "rf"}
      n_estimators: {type: int, default: 100}
      max_depth: {type: int, default: 12}
      min_samples_leaf: {type: int, default: 5}
    command: >
      python -m mibici.modeling.run_project
      --question {question}
      --model {model}
      --n-estimators {n_estimators}
      --max-depth {max_depth}
      --min-samples-leaf {min_samples_leaf}
